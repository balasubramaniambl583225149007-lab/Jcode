# Port for the web platform server
PORT=3000

# Authentication Password Gate
APP_PASSWORD=jcode123

# Master secret key for token signing & AES-256-GCM encryption at rest (64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: Path to custom jcode / AI coding agent CLI binary
# JCODE_BIN_PATH=/usr/local/bin/jcode

# Managed Sandbox Provider (E2B / CodeSandbox SDK)
# E2B_API_KEY=
# CODESANDBOX_API_KEY=

# GitHub OAuth Integration (Optional: fallback to PAT in UI if empty)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback

# LLM Providers (Optional for built-in jcode agent)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
